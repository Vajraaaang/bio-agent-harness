        },
        "checks_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "issuer_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
        },
        "signature_ed25519_hex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}$"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputReceipt"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "result_root_sha256",
        "manifest_sha256",
        "execution_tier",
        "verifier_sha256",
        "checked_at_utc",
        "checks_sha256",
        "issuer_key_id",
        "signature_ed25519_hex",
        "outputs"
      ],
      "additionalProperties": false
