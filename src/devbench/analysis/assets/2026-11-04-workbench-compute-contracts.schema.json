          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "free_disk_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "environment_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "watchdog_deadline_at_utc": {
          "$ref": "#/$defs/UtcSeconds"
