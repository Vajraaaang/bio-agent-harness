        "observed_at_utc",
        "hardware",
        "ram_bytes",
        "free_disk_bytes",
        "environment_sha256",
        "watchdog_deadline_at_utc"
      ],
      "additionalProperties": false
    },
    "ApprovalSignature": {
      "type": "object",
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "issuer_key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
        },
        "signature_ed25519_hex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{128}$"
        },
        "format": {
          "const": "devbench.manifest-signature/1"
        }
      },
      "required": [
        "manifest_sha256",
        "issuer_key_id",
        "signature_ed25519_hex",
        "format"
      ],
      "additionalProperties": false
    },
    "IPCFrame": {
      "$comment": "devbench.colab-ipc/1: four-byte unsigned big-endian payload length, then 1\u201365536 bytes of strict UTF-8 JSON. This schema validates the decoded payload.",
      "oneOf": [
        {
          "$ref": "#/$defs/IpcRequest"
        },
        {
          "$ref": "#/$defs/IpcResponse"
        }
      ]
    }
