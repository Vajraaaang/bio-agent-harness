    "ResultManifest": {
      "type": "object",
      "properties": {
        "format": {
          "const": "devbench.compute-result/1"
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "dispatch_id": {
          "$ref": "#/$defs/JobId"
        },
        "runtime_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_tier": {
          "enum": [
            "colab",
            "local_supervised"
          ]
        },
        "runtime_observation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "exit_code": {
          "const": 0
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OutputReceipt"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "format",
        "job_id",
        "manifest_sha256",
        "dispatch_id",
        "runtime_id",
        "execution_tier",
        "runtime_observation_sha256",
        "exit_code",
        "outputs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_tier": {
                "const": "colab"
              }
            }
          },
          "then": {
            "properties": {
              "runtime_id": {
                "$ref": "#/$defs/JobId"
              }
            }
          },
          "else": {
            "properties": {
              "runtime_id": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "VerificationReceipt": {
      "type": "object",
      "properties": {
        "format": {
          "const": "devbench.compute-verification/1"
        },
        "result_root_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "execution_tier": {
          "enum": [
            "colab",
            "local_supervised"
          ]
