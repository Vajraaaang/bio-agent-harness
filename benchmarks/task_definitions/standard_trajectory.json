{
  "schema_version": 1,
  "dataset": {
    "variant": "standard",
    "seed": 42
  },
  "answer_schema": {
    "type": "object",
    "required": [
      "monotonicity",
      "stage_kinetics",
      "master_regulators",
      "condition_number_validated",
      "biological_rationale"
    ],
    "properties": {
      "monotonicity": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "stage_kinetics": {
        "type": "object",
        "properties": {
          "E8.5": {
            "type": "number"
          },
          "E10.5": {
            "type": "number"
          },
          "E12.5": {
            "type": "number"
          },
          "E14.5": {
            "type": "number"
          }
        },
        "required": [
          "E8.5",
          "E10.5",
          "E12.5",
          "E14.5"
        ],
        "additionalProperties": false
      },
      "master_regulators": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 4,
        "maxItems": 4,
        "uniqueItems": true
      },
      "condition_number_validated": {
        "type": "boolean"
      },
      "biological_rationale": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "grader": {
    "type": "all_of",
    "config": {
      "children": [
        {
          "type": "longest_subsequence",
          "config": {
            "field": "master_regulators",
            "expected": [
              "Sox2",
              "Pax6",
              "Neurog2",
              "Tbr1"
            ],
            "pass_threshold": 1
          }
        },
        {
          "type": "numeric_tolerance",
          "config": {
            "field": "monotonicity",
            "expected": 1,
            "tolerances": {
              "type": "absolute",
              "value": 0
            }
          }
        },
        {
          "type": "equals",
          "config": {
            "field": "condition_number_validated",
            "expected": true
          }
        }
      ]
    }
  },
  "id": "standard_trajectory",
  "task": "Analyze counts.zarr and metadata.csv in the supplied workspace. This synthetic neural tube dataset contains Sox2, Pax6, Neurog2 and Tbr1. Infer their chronological peak-activation cascade. Calculate signed temporal monotonicity of the Tbr1 stage means. Return an object with master_regulators (an ordered list) and monotonicity (a number). Use numeric ages, not lexical stage ordering. Write final_discovery.json matching answer_schema.json. Include stage_kinetics, exactly four master_regulators, condition_number_validated and biological_rationale, plus the task-specific fields."
}
