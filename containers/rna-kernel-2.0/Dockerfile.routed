# Refresh all /opt/rna/runtime sources over the pinned limma-voom runtime.
ARG KERNEL_IMAGE=devbench-rna-kernel:2.0-thesis-voom-arm64
FROM ${KERNEL_IMAGE}

COPY src/devbench/adaptive/models.py \
    /opt/rna/runtime/devbench/adaptive/
COPY src/devbench/analysis/checkpoints.py \
    src/devbench/analysis/embedding.py \
    src/devbench/analysis/integration_metrics.py \
    src/devbench/analysis/singlecell.py \
    src/devbench/analysis/streaming.py \
    /opt/rna/runtime/devbench/analysis/
COPY src/devbench/core/input_files.py \
    src/devbench/core/rna_pathway_analysis.py \
    src/devbench/core/scientific_types.py \
    src/devbench/core/scrna_composition.py \
    src/devbench/core/scrna_composition_data.py \
    src/devbench/core/scrna_donor_trajectory.py \
    src/devbench/core/scrna_marker_inference.py \
    src/devbench/core/scrna_qc_selection.py \
    /opt/rna/runtime/devbench/core/
COPY src/devbench/engine/provenance.py \
    /opt/rna/runtime/devbench/engine/
COPY src/rna_kernels/r/bulk_deseq2_sensitivity.R \
    src/rna_kernels/r/bulk_dream.R \
    src/rna_kernels/r/bulk_edger.R \
    src/rna_kernels/r/bulk_latent_diagnostics.R \
    src/rna_kernels/r/bulk_voom_sensitivity.R \
    src/rna_kernels/r/mounted_edger.R \
    src/rna_kernels/r/mounted_general.R \
    src/rna_kernels/r/scrna_scran.R \
    /opt/rna/runtime/rna_kernels/r/
COPY src/rna_kernels/r/bulk_deseq2_sensitivity.R \
    src/rna_kernels/r/bulk_dream.R \
    src/rna_kernels/r/bulk_edger.R \
    src/rna_kernels/r/bulk_latent_diagnostics.R \
    src/rna_kernels/r/bulk_voom_sensitivity.R \
    src/rna_kernels/r/mounted_edger.R \
    src/rna_kernels/r/mounted_general.R \
    src/rna_kernels/r/scrna_scran.R \
    /opt/rna/runtime/devharness_server/r/
COPY src/rna_kernels/bulk_solver_policy.py \
    src/rna_kernels/embedding_qc.py \
    src/rna_kernels/mounted_bulk.py \
    src/rna_kernels/mounted_model.py \
    src/rna_kernels/mounted_rank.py \
    src/rna_kernels/rank_sensitivity.py \
    src/rna_kernels/scrna_nb_clustering.py \
    src/rna_kernels/scrna_nb_pseudobulk.py \
    src/rna_kernels/trajectory_zarr.py \
    /opt/rna/runtime/rna_kernels/

RUN --network=none --mount=type=tmpfs,target=/tmp \
    Rscript --vanilla -e ' \
      stopifnot( \
        as.character(packageVersion("edgeR")) == "4.10.7", \
        as.character(packageVersion("limma")) == "3.68.5", \
        as.character(packageVersion("DESeq2")) == "1.52.0", \
        as.character(packageVersion("variancePartition")) == "1.42.0", \
        as.character(packageVersion("statmod")) == "1.5.2" \
      ); \
      source("/opt/rna/runtime/rna_kernels/r/bulk_edger.R"); \
      source("/opt/rna/runtime/rna_kernels/r/bulk_voom_sensitivity.R"); \
      source("/opt/rna/runtime/rna_kernels/r/bulk_dream.R") \
    ' \
 && python3.13 -m rna_kernels.mounted_bulk --help > /dev/null \
 && python3.13 -m rna_kernels.mounted_scrna --help > /dev/null \
 && python3.13 -m devharness_server.tools_scrna_composition --help > /dev/null \
 && python3.13 -m devharness_server.tools_rna_pathways --help > /dev/null \
 && python3.13 -c 'from rna_kernels.bulk_solver_policy import freeze_bulk_solver; from rna_kernels.mounted_model import freeze_mounted_solver'
